# Alma Tech Consults - URL Routing & Security
RewriteEngine On
RewriteBase /almatech_site_final/

# Prevent direct access to sensitive files
<Files ~ "^\.">
  Require all denied
</Files>

Options -Indexes

# Admin
RewriteRule ^admin/?$ admin/index.php [L,QSA]

# Home page
RewriteRule ^home/?$ index.php [L,QSA]

# Projects - handle individual project pages
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^projects/([a-zA-Z0-9_-]+)/?$ project.php?slug=$1 [L,QSA]

# Shop module routes
RewriteRule ^shop/?$ shop/index.php [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^shop/category/([a-zA-Z0-9_-]+)/?$ shop/category.php?slug=$1 [L,QSA]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^shop/product/([a-zA-Z0-9_-]+)/?$ shop/product.php?slug=$1 [L,QSA]
RewriteRule ^shop/search/?$ shop/search.php [L,QSA]
RewriteRule ^shop/request/?$ shop/request.php [L,QSA]

# All other slugs go to page.php for database lookup (exclude known pages)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_URI} !^/(index|about|services|projects|blog|team|testimonials|contact|admin|shop|assets|includes|uploads|sql)\.php$ [NC]
RewriteRule ^([a-zA-Z0-9_-]+)/?$ page.php?slug=$1 [L,QSA]

ErrorDocument 404 /almatech_site_final/404.php
