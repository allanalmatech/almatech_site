# Leave BASE_URL empty to auto-detect from DOCUMENT_ROOT.
# Set it only if the site is installed in a subdirectory, e.g. BASE_URL=/almatech_site/
BASE_URL=
# Defaults to BASE_URL + admin/ when left empty.
ADMIN_URL=

# Use 127.0.0.1 instead of localhost if the host has no MySQL socket.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=almatech_site
# Shared hosts usually prefix the DB user, e.g. u12345678_almatech_site
DB_USER=root
DB_PASS=
